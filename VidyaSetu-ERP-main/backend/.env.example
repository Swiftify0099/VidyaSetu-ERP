# ─────────────────────────────────────────────────────
#  VidyaSetu ERP — Production Environment Configuration
#  Copy this file to .env locally or set these in Render Dashboard.
#  Never commit real secret credentials to version control!
# ─────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────
APP_NAME="VidyaSetu ERP"
APP_ENV=production
APP_DEBUG=false
APP_VERSION=1.0.0
APP_SECRET_KEY=your-super-secret-app-key-minimum-32-chars-change-this!

# ── Database ──────────────────────────────────────────
# Production PostgreSQL URL (e.g. Neon.tech or Replit Postgres)
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ── Security & JWT ────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-jwt-signing-key-minimum-32-chars-change-this!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS & Frontend Integration ──────────────────────
# Set FRONTEND_URL to your deployed frontend (e.g. Cloudflare Pages or Render)
FRONTEND_URL=https://vidyasetu.pages.dev
ALLOWED_ORIGINS=https://vidyasetu.pages.dev,http://localhost:5173,http://localhost:3000

# ── AI / OpenRouter Integration ───────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free
OPENROUTER_MAX_TOKENS=2048
OPENROUTER_TEMPERATURE=0.7
AI_SITE_URL=https://vidyasetu.pages.dev
AI_SITE_NAME="VidyaSetu ERP"

# ── Storage & Media Uploads ───────────────────────────
UPLOAD_BASE_DIR=./storage
MAX_FILE_SIZE_MB=50
MAX_VIDEO_SIZE_MB=500
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp
ALLOWED_DOC_TYPES=pdf,doc,docx,xls,xlsx,ppt,pptx
ALLOWED_VIDEO_TYPES=mp4,mov,avi,webm,mkv

# ── Redis / Background Jobs ───────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# ── Firebase Cloud Messaging (Optional) ───────────────
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
FIREBASE_PROJECT_ID=amc-ticketmanagement

# ── School Information ────────────────────────────────
SCHOOL_CODE=HMMV
SCHOOL_NAME="Hindkesri Maruti Mane Vidyalay"
SCHOOL_ADDRESS="Maharashtra, India"
SCHOOL_PHONE="02362-000000"
SCHOOL_EMAIL="info@hmmv.edu.in"
SCHOOL_WEBSITE="https://hmmv.edu.in"
PRINCIPAL_NAME="Shri. Ramchandra Patil"
CURRENT_ACADEMIC_YEAR=2025-2026

# ── Document Prefixes ─────────────────────────────────
RECEIPT_PREFIX=RCP
CERTIFICATE_PREFIX=CERT
GR_PREFIX=GR
VOUCHER_PREFIX=VCH
LEDGER_PREFIX=LDG
ADMISSION_PREFIX=ADM

# ── Security Policy ───────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=30
SESSION_TIMEOUT_MINUTES=120
PASSWORD_MIN_LENGTH=8
REQUIRE_PASSWORD_CHANGE_DAYS=90

# ── Pagination & Locale ───────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
TIMEZONE=Asia/Kolkata
DATE_FORMAT=DD/MM/YYYY
DEFAULT_LANGUAGE=mr

# ── SMTP Email Configuration ──────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=info@hmmv.edu.in
SMTP_FROM_NAME="VidyaSetu ERP"
SMTP_TLS=true
