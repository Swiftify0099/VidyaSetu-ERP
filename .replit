modules = ["python-base-3.13", "postgresql-16", "nodejs-20"]

[nix]
channel = "stable-25_05"
packages = [
  "cargo",
  "file",
  "freetype",
  "glibcLocales",
  "lcms2",
  "libiconv",
  "libimagequant",
  "libjpeg",
  "libtiff",
  "libwebp",
  "libxcrypt",
  "openjpeg",
  "rustc",
  "tcl",
  "tk",
  "zlib"
]

[userenv]

[userenv.shared]
VITE_API_URL = "/api/v1"
VITE_STORAGE_URL = "/storage"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "VidyaSetu ERP"

[[workflows.workflow]]
name = "VidyaSetu ERP"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = """
bash -lc '
cd /home/runner/workspace/backend &&
PYTHONPATH=/home/runner/workspace/backend python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 &

cd /home/runner/workspace/frontend &&
pnpm install &&
pnpm run dev --host 0.0.0.0 --port 5000
'
"""
waitForPort = 5000


[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8000
externalPort = 8000


[deployment]
deploymentTarget = "cloudrun"

run = """
bash -lc '
cd /home/runner/workspace/backend &&
PYTHONPATH=/home/runner/workspace/backend python -m uvicorn app.main:app --host 0.0.0.0 --port $PORT
'
"""
