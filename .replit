modules = ["python-base-3.13", "postgresql-16", "nodejs-20"]

[nix]
channel = "stable-25_05"
packages = ["cargo", "file", "freetype", "glibcLocales", "lcms2", "libiconv", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "rustc", "tcl", "tk", "zlib"]

[userenv]

[userenv.shared]
VITE_API_URL = "/api/v1"
VITE_STORAGE_URL = "/storage"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "VidyaSetu ERP"

[[workflows.workflow]]
name = "VidyaSetu ERP"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -lc 'cd /home/runner/workspace/backend && PYTHONPATH=/home/runner/workspace/backend /home/runner/workspace/.pythonlibs/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 >/tmp/vidyasetu-api.log 2>&1 & cd /home/runner/workspace/frontend && exec pnpm exec vite --host 0.0.0.0 --port 5000'"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5173
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000
