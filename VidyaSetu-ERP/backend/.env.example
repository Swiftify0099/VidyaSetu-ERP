# ─────────────────────────────────────────────────────
#  VidyaSetu ERP — Environment Configuration
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control!
# ─────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://vidyasetu_user:your_password@localhost:5432/vidyasetu

# ── Security ──────────────────────────────────────────
SECRET_KEY=your-super-secret-jwt-key-minimum-32-chars-change-this!
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── App ───────────────────────────────────────────────
APP_NAME=VidyaSetu ERP
APP_VERSION=1.0.0
APP_ENV=development
APP_DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── School Info ───────────────────────────────────────
SCHOOL_NAME=Hindkesri Maruti Mane Vidyalay
SCHOOL_ADDRESS=Maharashtra, India
SCHOOL_PHONE=02362-000000
SCHOOL_EMAIL=info@hmmv.edu.in
SCHOOL_WEBSITE=https://hmmv.edu.in
PRINCIPAL_NAME=Shri. Ramchandra Patil
CURRENT_ACADEMIC_YEAR=2025-2026

# ── Prefixes ──────────────────────────────────────────
RECEIPT_PREFIX=RCP
CERTIFICATE_PREFIX=CERT
GR_PREFIX=GR
VOUCHER_PREFIX=VCH
ADMISSION_PREFIX=ADM

# ── Storage ───────────────────────────────────────────
UPLOAD_BASE_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ── Notifications (Future) ────────────────────────────
# FIREBASE_CREDENTIALS_PATH=path/to/firebase-credentials.json
# SMS_API_KEY=your_msg91_or_twilio_key
# SMS_SENDER_ID=HMMV

# ── Security Policy ───────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=15
SESSION_TIMEOUT_MINUTES=480
PASSWORD_MIN_LENGTH=8

# ── Timezone ──────────────────────────────────────────
TIMEZONE=Asia/Kolkata
DATE_FORMAT=DD/MM/YYYY
DEFAULT_LANGUAGE=mr
